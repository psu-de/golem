{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psu-de.github.io/golem/contracts/0.1/tick-input.schema.json",
  "title": "Golem TickInput",
  "description": "§15.2 phase 1, §18.4 ingest() result: attributed key changes (§14.5), discrete events (§17.6), action reports (§9.6), infrastructure events (§12.3) and measurements. One object per tick; examples/tick-inputs.jsonl holds one per line.",
  "$ref": "#/$defs/TickInput",
  "$defs": {
    "TickInput": {
      "description": "§15.2 phase 1, §18.4 everything the backend hands over for one tick, fully JSON-serialisable so that recording it replays a session exactly (§15.5). Processing order (PD-11): a connected infra event first (it resets the confirmed view), then changes in list order, then events, then action reports, then the remaining infra events.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "tick",
        "infra",
        "changes",
        "events",
        "reports",
        "measurements"
      ],
      "properties": {
        "tick": {
          "description": "PD-2 the backend clock's tick number: 0 at the first tick after the first connect, +1 per physics tick, never reset (reports carry the same number as tick, PD-24).",
          "$ref": "wire.schema.json#/$defs/NonNegInt"
        },
        "infra": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InfraEvent"
          }
        },
        "changes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Change"
          }
        },
        "events": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BackendEvent"
          }
        },
        "reports": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ActionReport"
          }
        },
        "measurements": {
          "$ref": "#/$defs/Measurements"
        }
      }
    },
    "ActionId": {
      "description": "§15.5, PD-12 action id: assigned by the runtime when it calls start, 1 for the first action of the session and +1 per start, so replay reproduces it.",
      "$ref": "wire.schema.json#/$defs/PosInt"
    },
    "Change": {
      "description": "§14.5 one attributed world change, or a bulk chunk change (PD-10, always Outside).",
      "anyOf": [
        {
          "$ref": "#/$defs/KeyChange"
        },
        {
          "$ref": "world.schema.json#/$defs/ChunkLoad"
        },
        {
          "$ref": "world.schema.json#/$defs/ChunkUnload"
        }
      ]
    },
    "KeyChange": {
      "description": "§14.5 a key's new value (world.schema.json KeyValue) with its attribution cause (provisional, S-2).",
      "type": "object",
      "allOf": [
        {
          "$ref": "world.schema.json#/$defs/KeyValue"
        },
        {
          "type": "object",
          "required": [
            "cause"
          ],
          "properties": {
            "cause": {
              "$ref": "provisional.schema.json#/$defs/KeyCause"
            }
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "EventName": {
      "description": "§17.6 the event catalog; handler triggers name these (§11.3).",
      "enum": [
        "spawned",
        "died",
        "hurt",
        "entity_hurt",
        "chat",
        "whisper",
        "system",
        "entity_appeared",
        "entity_gone",
        "item_collected",
        "window_opened",
        "window_closed"
      ]
    },
    "BackendEvent": {
      "description": "§17.6 discrete events as the backend reports them, with Entity fields as EntityHandles. spawned and died are not reported here: the runtime derives them from the spawned and died infra events (PD-13).",
      "oneOf": [
        {
          "$ref": "#/$defs/Hurt"
        },
        {
          "$ref": "#/$defs/EntityHurt"
        },
        {
          "$ref": "#/$defs/Chat"
        },
        {
          "$ref": "#/$defs/Whisper"
        },
        {
          "$ref": "#/$defs/SystemMessage"
        },
        {
          "$ref": "#/$defs/EntityAppeared"
        },
        {
          "$ref": "#/$defs/EntityGone"
        },
        {
          "$ref": "#/$defs/ItemCollected"
        },
        {
          "$ref": "#/$defs/WindowOpened"
        },
        {
          "$ref": "#/$defs/WindowClosedEvent"
        }
      ]
    },
    "Hurt": {
      "description": "§17.6 hurt(amount, attacker): the bot takes damage.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "amount",
        "attacker"
      ],
      "properties": {
        "event": {
          "const": "hurt"
        },
        "amount": {
          "$ref": "wire.schema.json#/$defs/Float"
        },
        "attacker": {
          "anyOf": [
            {
              "$ref": "wire.schema.json#/$defs/EntityHandle"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "EntityHurt": {
      "description": "§17.6 entity_hurt(e, attacker): a tracked entity other than the bot takes damage (1.19.4+, decision 88).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "e",
        "attacker"
      ],
      "properties": {
        "event": {
          "const": "entity_hurt"
        },
        "e": {
          "$ref": "wire.schema.json#/$defs/EntityHandle"
        },
        "attacker": {
          "anyOf": [
            {
              "$ref": "wire.schema.json#/$defs/EntityHandle"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "Chat": {
      "description": "§17.6 chat(sender, text), including the bot's own messages.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "sender",
        "text"
      ],
      "properties": {
        "event": {
          "const": "chat"
        },
        "sender": {
          "$ref": "wire.schema.json#/$defs/WireString"
        },
        "text": {
          "$ref": "wire.schema.json#/$defs/WireString"
        }
      }
    },
    "Whisper": {
      "description": "§17.6 whisper(sender, text).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "sender",
        "text"
      ],
      "properties": {
        "event": {
          "const": "whisper"
        },
        "sender": {
          "$ref": "wire.schema.json#/$defs/WireString"
        },
        "text": {
          "$ref": "wire.schema.json#/$defs/WireString"
        }
      }
    },
    "SystemMessage": {
      "description": "§17.6 system(text).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "text"
      ],
      "properties": {
        "event": {
          "const": "system"
        },
        "text": {
          "$ref": "wire.schema.json#/$defs/WireString"
        }
      }
    },
    "EntityAppeared": {
      "description": "§17.6 entity_appeared(e): an entity starts being tracked.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "e"
      ],
      "properties": {
        "event": {
          "const": "entity_appeared"
        },
        "e": {
          "$ref": "wire.schema.json#/$defs/EntityHandle"
        }
      }
    },
    "EntityGone": {
      "description": "§17.6 entity_gone(id, kind): an entity stops being tracked.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "id",
        "kind"
      ],
      "properties": {
        "event": {
          "const": "entity_gone"
        },
        "id": {
          "$ref": "wire.schema.json#/$defs/Int"
        },
        "kind": {
          "$ref": "wire.schema.json#/$defs/EntityType"
        }
      }
    },
    "ItemCollected": {
      "description": "§17.6 item_collected(stack).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "stack"
      ],
      "properties": {
        "event": {
          "const": "item_collected"
        },
        "stack": {
          "$ref": "wire.schema.json#/$defs/ItemStack"
        }
      }
    },
    "WindowOpened": {
      "description": "§17.6 window_opened(menu_type) (\"\" for the horse screen, which has no menu type).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event",
        "menu_type"
      ],
      "properties": {
        "event": {
          "const": "window_opened"
        },
        "menu_type": {
          "$ref": "wire.schema.json#/$defs/WireString"
        }
      }
    },
    "WindowClosedEvent": {
      "description": "§17.6 window_closed: the server closed the bot's window.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "event"
      ],
      "properties": {
        "event": {
          "const": "window_closed"
        }
      }
    },
    "ActionReport": {
      "description": "§9.6 one report on one action, in issue order per strand; an action may get several (Running, then Issued, then a verdict).",
      "oneOf": [
        {
          "$ref": "#/$defs/ReportRunning"
        },
        {
          "$ref": "#/$defs/ReportIssued"
        },
        {
          "$ref": "#/$defs/ReportConfirmed"
        },
        {
          "$ref": "#/$defs/ReportRejected"
        },
        {
          "$ref": "#/$defs/ReportFailed"
        }
      ]
    },
    "ReportRunning": {
      "description": "§9.6 Running: the action is in progress (durative or ongoing).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "status"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionId"
        },
        "status": {
          "const": "Running"
        }
      }
    },
    "ReportIssued": {
      "description": "§9.6 Issued: all of the action's packets are sent; no verdict yet.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "status"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionId"
        },
        "status": {
          "const": "Issued"
        }
      }
    },
    "ReportConfirmed": {
      "description": "§9.6 Confirmed by the primitive's confirmation method (§17.1).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "status"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionId"
        },
        "status": {
          "const": "Confirmed"
        }
      }
    },
    "ReportRejected": {
      "description": "§9.6 Rejected(detail): the server reverted the action or contradicted its prediction (§14.3 folding).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "status",
        "detail"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionId"
        },
        "status": {
          "const": "Rejected"
        },
        "detail": {
          "$ref": "wire.schema.json#/$defs/WireString"
        }
      }
    },
    "ReportFailed": {
      "description": "§9.6 Failed(f): the primitive raised a declared failure (§17.9 fails) or WindowClosed; any other failure becomes ContractViolation (§9.5).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "action",
        "status",
        "failure"
      ],
      "properties": {
        "action": {
          "$ref": "#/$defs/ActionId"
        },
        "status": {
          "const": "Failed"
        },
        "failure": {
          "$ref": "wire.schema.json#/$defs/FailureValue"
        }
      }
    },
    "InfraEvent": {
      "description": "§12.3, §15.2 phase 1 connection and life-cycle events (PD-2, PD-13).",
      "oneOf": [
        {
          "$ref": "#/$defs/InfraConnected"
        },
        {
          "$ref": "#/$defs/InfraConnectFailed"
        },
        {
          "$ref": "#/$defs/InfraDisconnected"
        },
        {
          "$ref": "#/$defs/InfraKicked"
        },
        {
          "$ref": "#/$defs/InfraDied"
        },
        {
          "$ref": "#/$defs/InfraSpawned"
        }
      ]
    },
    "InfraConnected": {
      "description": "Login succeeded (the outcome of connect(), PD-2): server version, protocol number and the bot's entity id. world.tick counts from this tick (§15.5).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infra",
        "minecraft",
        "protocol",
        "entity_id"
      ],
      "properties": {
        "infra": {
          "const": "connected"
        },
        "minecraft": {
          "type": "string"
        },
        "protocol": {
          "$ref": "wire.schema.json#/$defs/NonNegInt"
        },
        "entity_id": {
          "$ref": "wire.schema.json#/$defs/Int"
        }
      }
    },
    "InfraConnectFailed": {
      "description": "A connect() attempt failed before login (counts toward max_reconnects, §12.2).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infra",
        "reason"
      ],
      "properties": {
        "infra": {
          "const": "connect_failed"
        },
        "reason": {
          "$ref": "wire.schema.json#/$defs/WireString"
        }
      }
    },
    "InfraDisconnected": {
      "description": "§12.3 Disconnected(reason): the connection was lost.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infra",
        "reason"
      ],
      "properties": {
        "infra": {
          "const": "disconnected"
        },
        "reason": {
          "$ref": "wire.schema.json#/$defs/WireString"
        }
      }
    },
    "InfraKicked": {
      "description": "§12.3 Kicked(reason): the server kicked the bot.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infra",
        "reason"
      ],
      "properties": {
        "infra": {
          "const": "kicked"
        },
        "reason": {
          "$ref": "wire.schema.json#/$defs/WireString"
        }
      }
    },
    "InfraDied": {
      "description": "§12.3 Died(reason): the bot died; the runtime fires the §17.6 died event with cause = reason.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infra",
        "reason"
      ],
      "properties": {
        "infra": {
          "const": "died"
        },
        "reason": {
          "$ref": "wire.schema.json#/$defs/WireString"
        }
      }
    },
    "InfraSpawned": {
      "description": "§17.6 the bot joined or respawned; the runtime fires the spawned event, emits respawned after a death, and assigns the start job after the first spawn of a connection (§12.1).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "infra"
      ],
      "properties": {
        "infra": {
          "const": "spawned"
        }
      }
    },
    "Measurements": {
      "description": "Measurements the runtime reads that are not world state: path_progress backs bot.path_progress (§17.2, nodes reached by the current pathfind, null when none runs); round_trip_ms feeds the settle window (§17.1) and is provisional (S-2).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "path_progress",
        "round_trip_ms"
      ],
      "properties": {
        "path_progress": {
          "anyOf": [
            {
              "$ref": "wire.schema.json#/$defs/NonNegInt"
            },
            {
              "type": "null"
            }
          ]
        },
        "round_trip_ms": {
          "$ref": "provisional.schema.json#/$defs/RoundTripTime"
        }
      }
    },
    "RecordedTick": {
      "description": "§15.5 one line of a replay recording: the tick's backend input and the supervisor commands applied in its phase 3, in arrival order.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "input",
        "commands"
      ],
      "properties": {
        "input": {
          "$ref": "#/$defs/TickInput"
        },
        "commands": {
          "type": "array",
          "items": {
            "$ref": "command.schema.json#/$defs/Command"
          }
        }
      }
    }
  }
}
