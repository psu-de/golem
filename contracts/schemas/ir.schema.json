{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://psu-de.github.io/golem/contracts/0.1/ir.schema.json",
  "title": "Golem IR",
  "description": "§18.2 root schema of <Bot>.golem-ir.json. Building blocks live in ir/types, ir/expr, ir/stmt-actions, ir/statechart and ir/handlers. Referential integrity, name and type grammars, state-id uniqueness and ordering are checked by scripts/check-ir.mjs.",
  "$ref": "#/$defs/Ir",
  "$defs": {
    "Ir": {
      "description": "§18.2 one <Bot>.golem-ir.json: exactly the sections header, types, failures, notices, consts, fns, tasks, activities, bot, contracts, with no generics and no unresolved names. Keys of every map section are in ascending order (check-ir). The IR embeds no registries or version data (CONTRACTS.md 'IR').",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "header",
        "types",
        "failures",
        "notices",
        "consts",
        "fns",
        "tasks",
        "activities",
        "bot",
        "contracts"
      ],
      "properties": {
        "header": {
          "$ref": "#/$defs/Header"
        },
        "types": {
          "description": "§18.2 structs, enums and window kinds the bot reaches, monomorphized, keyed by qualified name; built-in types (CONTRACTS.md 'Type references') are not listed.",
          "type": "object",
          "propertyNames": {
            "$ref": "ir/types.schema.json#/$defs/QualifiedName"
          },
          "additionalProperties": {
            "$ref": "ir/types.schema.json#/$defs/TypeDecl"
          }
        },
        "failures": {
          "description": "§18.2 user-declared failures the bot reaches, keyed by qualified name.",
          "type": "object",
          "propertyNames": {
            "$ref": "ir/types.schema.json#/$defs/QualifiedName"
          },
          "additionalProperties": {
            "$ref": "ir/types.schema.json#/$defs/FailureDecl"
          }
        },
        "notices": {
          "description": "§18.2 notices the bot reaches, keyed by qualified name.",
          "type": "object",
          "propertyNames": {
            "$ref": "ir/types.schema.json#/$defs/QualifiedName"
          },
          "additionalProperties": {
            "$ref": "ir/types.schema.json#/$defs/NoticeDecl"
          }
        },
        "consts": {
          "description": "§18.2 consts read at run time, evaluated to wire values.",
          "type": "object",
          "propertyNames": {
            "$ref": "ir/types.schema.json#/$defs/QualifiedName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/ConstDecl"
          }
        },
        "fns": {
          "description": "§18.2 fns the bot reaches: typed expression or statement trees, and extern fns (runtime-implemented members of bot, world and built-in types, filter leaves, prelude math) by name with their signatures.",
          "type": "object",
          "propertyNames": {
            "$ref": "ir/types.schema.json#/$defs/QualifiedName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Fn"
          }
        },
        "tasks": {
          "description": "§18.2 tasks the bot reaches, monomorphized: extern primitives without charts and composites with their statecharts.",
          "type": "object",
          "propertyNames": {
            "$ref": "ir/types.schema.json#/$defs/QualifiedName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Task"
          }
        },
        "activities": {
          "description": "§18.2 activity instances keyed by instance name (use instances and @attaches instances job.activity).",
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z_][A-Za-z0-9_]*(\\.[a-z_][A-Za-z0-9_]*)?$"
          },
          "additionalProperties": {
            "$ref": "ir/handlers.schema.json#/$defs/ActivityInstance"
          }
        },
        "bot": {
          "$ref": "#/$defs/Bot"
        },
        "contracts": {
          "description": "§18.2, decision 45 every task's requires and ensures as data for external planners; each ensures is a point-in-time fact (§14.5). check-ir verifies these trees equal the tasks' own clauses.",
          "type": "object",
          "propertyNames": {
            "$ref": "ir/types.schema.json#/$defs/QualifiedName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Contract"
          }
        }
      }
    },
    "Header": {
      "description": "§18.2 header: IR format version, Golem (spec) version, Minecraft version, bot name, source hash and the source table that IR spans index.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "ir_format",
        "golem",
        "minecraft",
        "bot",
        "source_hash",
        "sources"
      ],
      "properties": {
        "ir_format": {
          "const": "golem-ir/0.1"
        },
        "golem": {
          "description": "Spec version the compiler implements, e.g. 0.2.",
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
        },
        "minecraft": {
          "type": "string",
          "pattern": "^[0-9]+\\.[0-9]+(\\.[0-9]+)?$"
        },
        "bot": {
          "$ref": "ir/types.schema.json#/$defs/TypeIdent"
        },
        "source_hash": {
          "description": "sha256 over the sources' hashes in table order.",
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "ir/types.schema.json#/$defs/SourceFile"
          }
        }
      }
    },
    "ConstDecl": {
      "description": "§7.5, §18.2 evaluated constant: type and value in wire form (Goal-typed consts use the backend Goal encoding, PD-37).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "type",
        "value",
        "span"
      ],
      "properties": {
        "type": {
          "$ref": "ir/types.schema.json#/$defs/TypeRef"
        },
        "value": {
          "$ref": "wire.schema.json#/$defs/JsonValue"
        },
        "span": {
          "$ref": "ir/types.schema.json#/$defs/Span"
        }
      }
    },
    "Fn": {
      "description": "§7.4, §18.2 fn: monomorphized signature (a receiver is a first parameter named self), extern flag (implemented by the runtime; no body), view-dependence, and a body that is a single expression (fn f() = e) or a statement block.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "module",
        "name",
        "type_args",
        "params",
        "result",
        "extern",
        "view_dependent",
        "body",
        "span"
      ],
      "properties": {
        "module": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ]
        },
        "name": {
          "type": "string"
        },
        "type_args": {
          "type": "array",
          "items": {
            "$ref": "ir/types.schema.json#/$defs/TypeRef"
          }
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "ir/types.schema.json#/$defs/Param"
          }
        },
        "result": {
          "$ref": "ir/types.schema.json#/$defs/TypeRef"
        },
        "extern": {
          "type": "boolean"
        },
        "view_dependent": {
          "type": "boolean"
        },
        "body": {
          "anyOf": [
            {
              "$ref": "#/$defs/FnBody"
            },
            {
              "type": "null"
            }
          ]
        },
        "span": {
          "anyOf": [
            {
              "$ref": "ir/types.schema.json#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "FnBody": {
      "description": "§7.4 fn body: expression form or block form.",
      "oneOf": [
        {
          "description": "fn f(...) = expr",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "expr"
          ],
          "properties": {
            "expr": {
              "$ref": "ir/expr.schema.json#/$defs/Expr"
            }
          }
        },
        {
          "description": "fn f(...) { block }",
          "type": "object",
          "additionalProperties": false,
          "required": [
            "block"
          ],
          "properties": {
            "block": {
              "type": "array",
              "items": {
                "$ref": "ir/stmt-actions.schema.json#/$defs/FnStmt"
              }
            }
          }
        }
      ]
    },
    "Task": {
      "description": "§9, §18.2 task: signature, modifiers as written, effective irreversibility (declared on externs, inferred on composites), primitive class and confirmation method (externs), clauses as expression trees, old snapshot expressions (slot = index), uses (declared or inferred), inferred failure set, boundedness, may-pin flag and the statechart (null for extern).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "module",
        "name",
        "type_args",
        "params",
        "result",
        "pub",
        "modifiers",
        "irreversible",
        "clauses",
        "olds",
        "uses",
        "failures",
        "bounded",
        "may_pin",
        "chart",
        "span"
      ],
      "properties": {
        "kind": {
          "enum": [
            "extern",
            "composite"
          ]
        },
        "module": {
          "type": "string"
        },
        "name": {
          "$ref": "ir/types.schema.json#/$defs/Ident"
        },
        "type_args": {
          "type": "array",
          "items": {
            "$ref": "ir/types.schema.json#/$defs/TypeRef"
          }
        },
        "params": {
          "type": "array",
          "items": {
            "$ref": "ir/types.schema.json#/$defs/Param"
          }
        },
        "result": {
          "$ref": "ir/types.schema.json#/$defs/TypeRef"
        },
        "pub": {
          "type": "boolean"
        },
        "modifiers": {
          "type": "array",
          "items": {
            "enum": [
              "extern",
              "ongoing",
              "unchecked",
              "irreversible"
            ]
          },
          "uniqueItems": true
        },
        "irreversible": {
          "type": "boolean"
        },
        "primitive": {
          "description": "Extern only: the backend primitive name (backend-data.schema.json PrimitiveName).",
          "$ref": "backend-data.schema.json#/$defs/PrimitiveName"
        },
        "class": {
          "description": "§9.6 extern only: instant, durative or ongoing.",
          "enum": [
            "instant",
            "durative",
            "ongoing"
          ]
        },
        "confirm": {
          "description": "§17.1 extern only: confirmation methods, informative for backends and conformance tests.",
          "type": "array",
          "items": {
            "enum": [
              "ack",
              "settle",
              "state",
              "sent"
            ]
          },
          "uniqueItems": true
        },
        "clauses": {
          "$ref": "#/$defs/Clauses"
        },
        "olds": {
          "type": "array",
          "items": {
            "$ref": "ir/expr.schema.json#/$defs/Expr"
          }
        },
        "uses": {
          "$ref": "ir/types.schema.json#/$defs/ResourceSet"
        },
        "failures": {
          "description": "§13.5 inferred failure set, sorted: qualified names of user failures and built-in names.",
          "type": "array",
          "items": {
            "$ref": "ir/types.schema.json#/$defs/QualifiedName"
          },
          "uniqueItems": true
        },
        "bounded": {
          "type": "boolean"
        },
        "may_pin": {
          "type": "boolean"
        },
        "chart": {
          "anyOf": [
            {
              "$ref": "ir/statechart.schema.json#/$defs/Statechart"
            },
            {
              "type": "null"
            }
          ]
        },
        "span": {
          "$ref": "ir/types.schema.json#/$defs/Span"
        }
      }
    },
    "Clauses": {
      "description": "§9.2-§9.3 the task's clauses in source order per kind, implicit clauses (§9.6, §17.1) first.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "requires",
        "invariants",
        "maintains",
        "ensures",
        "progress",
        "timeout",
        "stalls_after",
        "fails",
        "attaches"
      ],
      "properties": {
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/RequiresClause"
          }
        },
        "invariants": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/InvariantClause"
          }
        },
        "maintains": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/MaintainsClause"
          }
        },
        "ensures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/EnsuresClause"
          }
        },
        "progress": {
          "anyOf": [
            {
              "$ref": "#/$defs/ProgressClause"
            },
            {
              "type": "null"
            }
          ]
        },
        "timeout": {
          "anyOf": [
            {
              "$ref": "#/$defs/TimeoutClause"
            },
            {
              "type": "null"
            }
          ]
        },
        "stalls_after": {
          "anyOf": [
            {
              "$ref": "#/$defs/StallsAfterClause"
            },
            {
              "type": "null"
            }
          ]
        },
        "fails": {
          "description": "§9.5 @fails, qualified failure names as written.",
          "type": "array",
          "items": {
            "$ref": "ir/types.schema.json#/$defs/QualifiedName"
          }
        },
        "attaches": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AttachesClause"
          }
        }
      }
    },
    "RequiresClause": {
      "description": "§9.3 @requires E [else fail F]; implicit marks the §9.6 alive clause or a §17.1 window-open clause (else_fail WindowClosed(task)).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expr",
        "else_fail",
        "implicit",
        "text",
        "span"
      ],
      "properties": {
        "expr": {
          "$ref": "ir/expr.schema.json#/$defs/Expr"
        },
        "else_fail": {
          "anyOf": [
            {
              "$ref": "ir/stmt-actions.schema.json#/$defs/FailureCtor"
            },
            {
              "type": "null"
            }
          ]
        },
        "implicit": {
          "anyOf": [
            {
              "enum": [
                "alive",
                "window_open"
              ]
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "description": "The clause's source text (§9.3: the clause field of Unmet, Broken and ContractViolation); \"alive\" for the implicit requires !bot.dead.",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "ir/types.schema.json#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "InvariantClause": {
      "description": "§9.3 @invariant E [else fail F].",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expr",
        "else_fail",
        "text",
        "span"
      ],
      "properties": {
        "expr": {
          "$ref": "ir/expr.schema.json#/$defs/Expr"
        },
        "else_fail": {
          "anyOf": [
            {
              "$ref": "ir/stmt-actions.schema.json#/$defs/FailureCtor"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "description": "The clause's source text (§9.3: the clause field of Unmet, Broken and ContractViolation); \"alive\" for the implicit requires !bot.dead.",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "ir/types.schema.json#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "MaintainsClause": {
      "description": "§9.3 @maintains E [tolerate D] [else fail F]; tolerate null means 0t.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expr",
        "tolerate",
        "else_fail",
        "text",
        "span"
      ],
      "properties": {
        "expr": {
          "$ref": "ir/expr.schema.json#/$defs/Expr"
        },
        "tolerate": {
          "anyOf": [
            {
              "$ref": "ir/expr.schema.json#/$defs/Expr"
            },
            {
              "type": "null"
            }
          ]
        },
        "else_fail": {
          "anyOf": [
            {
              "$ref": "ir/stmt-actions.schema.json#/$defs/FailureCtor"
            },
            {
              "type": "null"
            }
          ]
        },
        "text": {
          "description": "The clause's source text (§9.3: the clause field of Unmet, Broken and ContractViolation); \"alive\" for the implicit requires !bot.dead.",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "ir/types.schema.json#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "EnsuresClause": {
      "description": "§9.3 @ensures E, evaluated once at completion; a point-in-time fact (§14.5).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expr",
        "text",
        "span"
      ],
      "properties": {
        "expr": {
          "$ref": "ir/expr.schema.json#/$defs/Expr"
        },
        "text": {
          "description": "The clause's source text (§9.3: the clause field of Unmet, Broken and ContractViolation); \"alive\" for the implicit requires !bot.dead.",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "ir/types.schema.json#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "ProgressClause": {
      "description": "§9.3 @progress M increasing|decreasing [by m] within W; by null means the default 1 / 1t.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "metric",
        "direction",
        "by",
        "within",
        "text",
        "span"
      ],
      "properties": {
        "metric": {
          "$ref": "ir/expr.schema.json#/$defs/Expr"
        },
        "direction": {
          "enum": [
            "increasing",
            "decreasing"
          ]
        },
        "by": {
          "anyOf": [
            {
              "$ref": "ir/expr.schema.json#/$defs/Expr"
            },
            {
              "type": "null"
            }
          ]
        },
        "within": {
          "$ref": "ir/expr.schema.json#/$defs/Expr"
        },
        "text": {
          "description": "The clause's source text (§9.3: the clause field of Unmet, Broken and ContractViolation); \"alive\" for the implicit requires !bot.dead.",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "ir/types.schema.json#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "TimeoutClause": {
      "description": "§9.3 @timeout D.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "text",
        "span"
      ],
      "properties": {
        "duration": {
          "$ref": "ir/expr.schema.json#/$defs/Expr"
        },
        "text": {
          "description": "The clause's source text (§9.3: the clause field of Unmet, Broken and ContractViolation); \"alive\" for the implicit requires !bot.dead.",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "ir/types.schema.json#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "StallsAfterClause": {
      "description": "§9.3, decision 76 @stalls_after D on ongoing composites.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "duration",
        "text",
        "span"
      ],
      "properties": {
        "duration": {
          "$ref": "ir/expr.schema.json#/$defs/Expr"
        },
        "text": {
          "description": "The clause's source text (§9.3: the clause field of Unmet, Broken and ContractViolation); \"alive\" for the implicit requires !bot.dead.",
          "type": "string"
        },
        "span": {
          "anyOf": [
            {
              "$ref": "ir/types.schema.json#/$defs/Span"
            },
            {
              "type": "null"
            }
          ]
        }
      }
    },
    "AttachesClause": {
      "description": "§11.7, decision 90 @attaches a(args): the instance it creates (activities.<instance>).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "instance",
        "activity",
        "span"
      ],
      "properties": {
        "instance": {
          "type": "string"
        },
        "activity": {
          "$ref": "ir/types.schema.json#/$defs/QualifiedName"
        },
        "span": {
          "$ref": "ir/types.schema.json#/$defs/Span"
        }
      }
    },
    "Bot": {
      "description": "§12, §18.2 bot section: instance order (§11.6), job signatures with their root statecharts, the start job with wire-encoded args, and settings with defaults resolved (§12.2).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "instances",
        "jobs",
        "start",
        "settings"
      ],
      "properties": {
        "name": {
          "$ref": "ir/types.schema.json#/$defs/TypeIdent"
        },
        "instances": {
          "description": "use instances in the order of their use lines (§11.6).",
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "jobs": {
          "description": "§12.1 jobs keyed by the job task's qualified name, which is also the job's name on the wire (PD-22).",
          "type": "object",
          "propertyNames": {
            "$ref": "ir/types.schema.json#/$defs/QualifiedName"
          },
          "additionalProperties": {
            "$ref": "#/$defs/Job"
          }
        },
        "start": {
          "anyOf": [
            {
              "$ref": "#/$defs/StartJob"
            },
            {
              "type": "null"
            }
          ]
        },
        "settings": {
          "$ref": "#/$defs/Settings"
        }
      }
    },
    "Job": {
      "description": "§12.1 one job: its wire-typed signature (defaults as wire values), the instances it attaches (§11.7), and the job-root statechart (owner job:<task>) that runs the task as the thread root.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "params",
        "result",
        "attaches",
        "root"
      ],
      "properties": {
        "params": {
          "type": "array",
          "items": {
            "$ref": "ir/types.schema.json#/$defs/Param"
          }
        },
        "result": {
          "$ref": "ir/types.schema.json#/$defs/TypeRef"
        },
        "attaches": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "root": {
          "$ref": "ir/statechart.schema.json#/$defs/Statechart"
        }
      }
    },
    "StartJob": {
      "description": "§12.1 start t(args): the job and its constant arguments as a wire object by parameter name, defaults filled.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job",
        "args"
      ],
      "properties": {
        "job": {
          "$ref": "ir/types.schema.json#/$defs/QualifiedName"
        },
        "args": {
          "$ref": "wire.schema.json#/$defs/WireObject"
        }
      }
    },
    "Settings": {
      "description": "§12.2 runtime settings with defaults resolved; durations in ticks.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "job_priority",
        "confirm_timeout",
        "max_pending",
        "atomic_limit",
        "reconnect_delay",
        "max_reconnects"
      ],
      "properties": {
        "job_priority": {
          "$ref": "wire.schema.json#/$defs/Int"
        },
        "confirm_timeout": {
          "$ref": "wire.schema.json#/$defs/Duration"
        },
        "max_pending": {
          "$ref": "wire.schema.json#/$defs/PosInt"
        },
        "atomic_limit": {
          "$ref": "wire.schema.json#/$defs/PosInt"
        },
        "reconnect_delay": {
          "$ref": "wire.schema.json#/$defs/Duration"
        },
        "max_reconnects": {
          "$ref": "wire.schema.json#/$defs/NonNegInt"
        }
      }
    },
    "Contract": {
      "description": "§18.2, decision 45 one task's contract as data: parameters, requires and ensures trees (copies of the task's clauses).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "params",
        "result",
        "requires",
        "ensures"
      ],
      "properties": {
        "params": {
          "type": "array",
          "items": {
            "$ref": "ir/types.schema.json#/$defs/Param"
          }
        },
        "result": {
          "$ref": "ir/types.schema.json#/$defs/TypeRef"
        },
        "requires": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContractFact"
          }
        },
        "ensures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/ContractFact"
          }
        }
      }
    },
    "ContractFact": {
      "description": "One requires or ensures clause for planners; point_in_time is true for ensures (§14.5: holds at completion only, re-check before relying on it).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "expr",
        "text",
        "point_in_time"
      ],
      "properties": {
        "expr": {
          "$ref": "ir/expr.schema.json#/$defs/Expr"
        },
        "text": {
          "type": "string"
        },
        "point_in_time": {
          "type": "boolean"
        }
      }
    }
  }
}
