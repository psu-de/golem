        "items",
        "span"
      ],
      "properties": {
        "kind": {
          "const": "set"
        },
        "type": {
          "$ref": "types.schema.json#/$defs/TypeRef"
        },
        "items": {
          "$ref": "#/$defs/Expr"
        },
        "span": {
          "$ref": "types.schema.json#/$defs/Span"
        }
      }
    },
    "ExprMapNew": {
      "description": "§7.3, decision 133 Map(entries): duplicate keys raise Defect(InvalidArgument).",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "type",
        "entries",
        "span"
      ],
      "properties": {
        "kind": {
          "const": "map"
        },
        "type": {
          "$ref": "types.schema.json#/$defs/TypeRef"
        },
        "entries": {
          "$ref": "#/$defs/Expr"
        },
        "span": {
          "$ref": "types.schema.json#/$defs/Span"
        }
      }
    },
    "ExprStruct": {
      "description": "§6.3 struct construction, including the built-in value types BlockPos(x, y, z), Vec3(x, y, z), Region(min, max), Range and Entry. fields holds every field in declaration order, defaults filled.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "type",
        "fields",
        "span"
      ],
      "properties": {
        "kind": {
          "const": "struct"
        },
        "type": {
          "$ref": "types.schema.json#/$defs/TypeRef"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Expr"
          }
        },
        "order": {
          "description": "Evaluation order as parameter indices, present only when it differs from parameter order (named arguments written out of order, §7.1, PD-18).",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "span": {
          "$ref": "types.schema.json#/$defs/Span"
        }
      }
    },
    "ExprVariant": {
      "description": "§6.3 enum variant construction, e.g. Goal.At(p) or Face.Up; the enum is the node's type.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "type",
        "variant",
        "fields",
        "span"
      ],
      "properties": {
        "kind": {
          "const": "variant"
        },
        "type": {
          "$ref": "types.schema.json#/$defs/TypeRef"
        },
        "variant": {
          "$ref": "types.schema.json#/$defs/TypeIdent"
        },
        "fields": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Expr"
          }
        },
        "order": {
          "description": "Evaluation order as parameter indices, present only when it differs from parameter order (named arguments written out of order, §7.1, PD-18).",
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0
          }
        },
        "span": {
          "$ref": "types.schema.json#/$defs/Span"
        }
      }
    },
    "ExprCopy": {
      "description": "§6.3 generated s.copy(field = value, ...): object with the named fields replaced, evaluated in the listed order.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "kind",
        "type",
        "object",
        "set",
        "span"
      ],
      "properties": {
        "kind": {
          "const": "copy"
        },
        "type": {
          "$ref": "types.schema.json#/$defs/TypeRef"
